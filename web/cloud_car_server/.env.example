# ===== 华为云网页控制 · 本地后端配置 =====
# 复制本文件为 .env 并填入真实值。.env 已 gitignore，切勿提交。

# 访问密钥 AK/SK：华为云控制台 -> 右上角账号 -> 我的凭证 -> 访问密钥 -> 新增/下载 credentials.csv
# 注意：这对 AK/SK 必须来自"拥有该 IoTDA 实例的同一个账号/IAM用户"，且该用户已获授 IoTDA 权限，
# 否则专属域名会报 401 IOTDA.000002 Authentication failed。
HW_AK=YOUR_ACCESS_KEY
HW_SK=YOUR_SECRET_KEY

# 项目ID：我的凭证 -> API 凭证 -> 对应区域(cn-north-4)的"项目ID"（不是账号ID）
HW_PROJECT_ID=YOUR_PROJECT_ID

# 区域ID：与应用侧接入地址中的区域一致（华北-北京四 = cn-north-4）
HW_REGION=cn-north-4

# IoTDA 应用侧接入地址(API)：IoTDA 控制台 -> 总览 -> 接入信息 -> 应用侧接入地址，只填域名
# 形如 xxxxxxxxxx.st1.iotda-app.cn-north-4.myhuaweicloud.com
HW_IOTDA_APP_ENDPOINT=YOUR_INSTANCE.st1.iotda-app.cn-north-4.myhuaweicloud.com

# 设备ID：注册设备时生成（与固件 cloud_config.h 里的 CLOUD_DEVICE_ID 一致）
HW_DEVICE_ID=YOUR_DEVICE_ID

# 产品模型服务ID（与固件 CLOUD_SERVICE_ID 一致）
HW_SERVICE_ID=Industrial_Internet

# 后端监听端口
PORT=3000
